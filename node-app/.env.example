# ============================================================
# 증권회사 투자상담 챗봇 웹앱 환경변수
# Lex 금융투자 상담 도메인 기준
# ============================================================

# ------------------------------------------------------------
# AWS Lex V2 (aws-lex 엔진 사용 시 필수)
# ------------------------------------------------------------
AWS_REGION=ap-northeast-2
LEX_BOT_ID=VP2C22LIIZ
LEX_BOT_ALIAS_ID=WLCO3AVN1Z
LEX_LOCALE_ID=ko_KR
DEFAULT_AI_ENGINE=aws-lex
ENABLE_LOCAL_RESERVATION_FLOW=false

# 슬롯 자동완성 목록 (Lex Models API 호출 없이 직접 지정)
BRANCH_VALUES=강남WM센터,여의도지점,압구정PB센터,종로지점,판교지점
PRODUCT_VALUES=국내주식,해외주식,ETF,ELS,채권,펀드,ISA,연금저축

# ------------------------------------------------------------
# Azure CLU (azure-clu 엔진 사용 시 필수)
# ------------------------------------------------------------
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
AZURE_CLU_PROJECT=FinanceInvestBot
AZURE_CLU_DEPLOYMENT=production

# ------------------------------------------------------------
# Ollama (ollama 엔진 직접 호출 시)
# docker-compose 환경에서는 OLLAMA_SERVER_URL 만 사용
# ------------------------------------------------------------
OLLAMA_MODEL=exaone3.5
