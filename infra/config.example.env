# ===== Lex Lab Bootstrap Config =====
# 필수
AWS_REGION=ap-northeast-2
BOT_NAME=FinanceInvestBot
BOT_DESCRIPTION="금융투자/증권사 투자상담 봇 (실습)"
LOCALE_ID=ko_KR

# Lex가 Assume할 IAM Role (없으면 스크립트가 생성 시도)
LEX_ROLE_NAME=LexLabServiceRole

# 선택: Alias에 Lambda CodeHook 연결 (Fulfillment)
# - lambda/fulfillment.js 를 Lambda로 배포한 ARN을 넣으세요.
LAMBDA_ARN=

# Alias/버전
BOT_ALIAS_NAME=DEV
IDLE_SESSION_TTL=300
NLU_CONFIDENCE=0.40

# 슬롯타입 값(원하면 추가/수정)
BRANCH_VALUES="강남WM센터,여의도지점,압구정PB센터,종로지점,판교지점"
PRODUCT_VALUES="국내주식,해외주식,ETF,ELS,채권,펀드,ISA,연금저축"
